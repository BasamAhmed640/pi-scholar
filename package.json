{
  "name": "pi-scholar",
  "version": "0.1.2",
  "private": true,
  "description": "Local PDF study workflows for Pi and Obsidian",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
